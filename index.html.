<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fbe3e8">
<title>Para ti, mi amor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
:root{
  --blush:#fbe3e8; --petal:#f4b6c6; --rose:#c24468; --wine:#5a1330; --gold:#c99a52; --ivory:#fff8f4;
  --script:'Great Vibes','Snell Roundhand','Brush Script MT',cursive;
  --serif:'Cormorant Garamond',Georgia,'Times New Roman',serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden}
body{font-family:var(--serif);font-weight:500;color:var(--wine);font-size:20px;
  background:radial-gradient(120% 80% at 50% 0%,#fff3f0 0%,var(--blush) 45%,#f2a9bd 100%);touch-action:manipulation}
#petals{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
button{font-family:inherit}
:focus-visible{outline:3px solid var(--rose);outline-offset:3px}

/* ---------- Bloqueo ---------- */
#lock{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:24px;
  background:radial-gradient(120% 80% at 50% 0%,#fff3f0,var(--blush) 50%,#f2a9bd);transition:opacity .9s,visibility .9s}
#lock.gone{opacity:0;visibility:hidden}
.card{width:100%;max-width:360px;text-align:center;padding:38px 26px 30px;border-radius:30px;background:rgba(255,248,244,.75);
  border:1.5px solid var(--gold);box-shadow:0 18px 50px rgba(194,68,104,.25)}
.wax{width:66px;height:66px;margin:-72px auto 18px;border-radius:50%;display:grid;place-items:center;color:#ffe9ef;font-size:30px;
  background:radial-gradient(circle at 35% 30%,#e0698a,#b02c55 60%,#6e1232);box-shadow:0 8px 20px rgba(90,19,48,.4)}
.card h2{font-family:var(--script);font-weight:400;font-size:2.6rem;margin:0 0 4px;color:var(--rose)}
.card p{margin:0 0 20px;font-size:1.15rem}
.card input{width:100%;padding:14px 16px;border-radius:999px;border:1.5px solid var(--petal);background:#fff;color:var(--wine);
  font:inherit;font-size:18px;text-align:center;margin-bottom:12px}
.btn{font:inherit;font-size:1.15rem;font-weight:600;cursor:pointer;border:0;border-radius:999px;padding:13px 28px;color:#fff;
  background:linear-gradient(135deg,#d9577a,var(--rose) 60%,#a82e55);box-shadow:0 8px 20px rgba(194,68,104,.35);transition:transform .15s}
.btn:active{transform:scale(.96)}
.card .btn{width:100%}
#err{min-height:26px;margin-top:10px;font-size:1rem;color:#a82e55;font-style:italic}
.shake{animation:shake .4s}
@keyframes shake{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

/* ---------- Deck ---------- */
#deck{position:fixed;inset:0;z-index:1;display:none;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;
  scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
#deck::-webkit-scrollbar{display:none}
#deck.show{display:flex;animation:fade 1.2s ease both}
@keyframes fade{from{opacity:0}to{opacity:1}}
.slide{flex:0 0 100%;width:100%;height:100%;scroll-snap-align:start;scroll-snap-stop:always;overflow-y:auto;display:flex;
  padding:max(28px,env(safe-area-inset-top)) 24px calc(96px + env(safe-area-inset-bottom));text-align:center}
.in{margin:auto;width:100%;max-width:440px}

.script{font-family:var(--script);font-weight:400;color:var(--rose);line-height:1}
.kick{font-style:italic;font-size:1.25rem;color:var(--gold);margin:0 0 6px}
.hero h1{font-size:clamp(4.2rem,24vw,7rem);margin:0 0 18px}
.hero p,.lead{font-size:1.4rem;line-height:1.55;margin:0 auto;max-width:21em}
.hero .hint{margin-top:34px;font-size:1.1rem;font-style:italic;color:var(--gold);animation:nudge 1.8s ease-in-out infinite}
@keyframes nudge{50%{transform:translateX(10px)}}
h2.script{font-size:3.1rem;margin:0 0 18px}

/* Foto en arco */
.arch{width:min(78vw,340px);aspect-ratio:3/4;margin:0 auto;border-radius:999px 999px 26px 26px;overflow:hidden;padding:7px;
  background:linear-gradient(160deg,#e9c88f,var(--gold) 50%,#a97a35);box-shadow:0 20px 45px rgba(90,19,48,.3);transform:rotate(-1.5deg)}
.photo:nth-of-type(odd) .arch{transform:rotate(1.5deg)}
.arch img{width:100%;height:100%;object-fit:cover;display:block;border-radius:999px 999px 20px 20px}
.cap{font-family:var(--script);font-size:2.4rem;color:var(--rose);margin:24px 0 0;line-height:1.1}

/* Corazones-mensaje */
.hearts{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:300px;margin:22px auto 0}
.h{aspect-ratio:1;border:0;background:none;cursor:pointer;font-size:5.2rem;line-height:1;color:var(--petal);
  filter:drop-shadow(0 6px 10px rgba(194,68,104,.3));transition:transform .2s,color .3s}
.h:active{transform:scale(.85)}
.h.on{color:var(--rose);animation:beat .6s}
@keyframes beat{40%{transform:scale(1.25)}}
#msg{min-height:92px;margin:14px auto 0;font-family:var(--script);font-size:2.4rem;line-height:1.15;color:var(--rose)}
#msg.pop{animation:pop .5s}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.95)}to{opacity:1;transform:none}}

/* Sobre y carta */
.envelope{position:relative;width:min(80vw,320px);aspect-ratio:3/2;margin:26px auto 0;border:0;background:none;cursor:pointer;perspective:800px;
  transition:opacity .7s,transform .7s}
.env-back{position:absolute;inset:0;border-radius:10px;background:linear-gradient(160deg,#fff0ee,#f2b9c8);box-shadow:0 16px 34px rgba(90,19,48,.3)}
.flap{position:absolute;left:0;right:0;top:0;height:58%;transform-origin:top;transition:transform .7s;z-index:2}
.flap svg{display:block;width:100%;height:100%}
.envelope.open .flap{transform:rotateX(180deg)}
.seal{position:absolute;z-index:3;left:50%;top:58%;translate:-50% -50%;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;
  color:#ffe9ef;font-size:24px;background:radial-gradient(circle at 35% 30%,#e0698a,#b02c55 60%,#6e1232);box-shadow:0 5px 12px rgba(90,19,48,.4);transition:opacity .3s}
.envelope.open .seal{opacity:0}
.envelope.gone{opacity:0;transform:scale(.9) translateY(30px);pointer-events:none;position:absolute}
.tap{margin-top:18px;font-style:italic;color:var(--gold);font-size:1.15rem}
.sheet{display:none;background:var(--ivory);padding:30px 24px;border-radius:8px;text-align:left;font-size:1.3rem;line-height:1.7;font-weight:500;
  box-shadow:0 18px 40px rgba(90,19,48,.28);border:1px solid #f1d3c2;white-space:pre-line}
.sheet.show{display:block;animation:rise .9s ease both}
@keyframes rise{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:none}}
.sheet .sign{display:block;font-family:var(--script);font-weight:400;font-size:2.6rem;color:var(--rose);margin-top:10px;white-space:normal}

/* Final */
.big{width:min(62vw,240px);aspect-ratio:1;margin:12px auto 0;border:0;background:none;cursor:pointer;font-size:min(48vw,190px);line-height:1;color:var(--rose);
  filter:drop-shadow(0 12px 20px rgba(194,68,104,.4));animation:pulse 1.4s ease-in-out infinite}
@keyframes pulse{50%{transform:scale(1.1)}}
.final h2{font-size:4.2rem;margin:6px 0 8px}
.count{margin-top:14px;font-size:1.25rem;font-style:italic}

/* Navegación */
#nav{position:fixed;z-index:5;left:0;right:0;bottom:0;display:none;align-items:center;justify-content:space-between;
  padding:12px 22px calc(16px + env(safe-area-inset-bottom));pointer-events:none}
#nav.show{display:flex}
#dots{display:flex;gap:8px;pointer-events:auto}
#dots i{width:8px;height:8px;border-radius:50%;background:var(--petal);transition:all .3s}
#dots i.on{width:24px;border-radius:8px;background:var(--rose)}
.arrow{pointer-events:auto;width:52px;height:52px;border-radius:50%;border:1.5px solid var(--gold);background:rgba(255,248,244,.85);
  color:var(--rose);font-size:1.5rem;cursor:pointer;transition:opacity .3s}
.arrow:disabled{opacity:0;pointer-events:none}

/* Corazones al tocar */
.fly{position:fixed;z-index:30;pointer-events:none;font-size:22px;color:var(--rose);animation:fly 1.4s ease-out forwards}
@keyframes fly{to{transform:translate(var(--dx),-170px) scale(1.5) rotate(var(--rot));opacity:0}}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}#deck{scroll-behavior:auto}}
</style>
</head>
<body>
<canvas id="petals" aria-hidden="true"></canvas>

<div id="lock">
  <div class="card">
    <div class="wax">♥</div>
    <h2>Solo para ti</h2>
    <p>Escribe la contraseña para abrir tu regalo</p>
    <input type="password" id="pass" placeholder="Contraseña" autocomplete="off" aria-label="Contraseña">
    <button class="btn" id="enter">Abrir</button>
    <div id="err" role="alert"></div>
  </div>
</div>

<div id="deck" aria-live="off">
  <section class="slide hero"><div class="in">
    <p class="kick">un pequeño rincón solo para nosotros</p>
    <h1 class="script">Para ti, mi amor</h1>
    <p>De todos los lugares del mundo, mi favorito siempre será donde esté contigo.</p>
    <p class="hint">desliza para seguir →</p>
  </div></section>

  <section class="slide"><div class="in">
    <h2 class="script">Lo que más quiero</h2>
    <p class="lead">No hace falta una fecha especial para recordarte lo importante que eres para mí. Quería hacerte algo diferente, guardar aquí algunos de nuestros momentos y recordarte que, entre tantas cosas bonitas de la vida, tú eres una de mis favoritas.</p>
  </div></section>

  <section class="slide photo"><div class="in">
<div class="arch"><img src="data:image/jpeg;base64," alt="Nuestro primer recuerdo" style="object-position:50% 38%"></div>
<p class="cap">Nuestro primer recuerdo</p></div></section>
<section class="slide photo"><div class="in">
<div class="arch"><img src="data:image/jpeg;base64," alt="Ese beso que guardo conmigo" style="object-position:45% 40%"></div>
<p class="cap">Ese beso que guardo conmigo</p></div></section>
<section class="slide photo"><div class="in">
<div class="arch"><img src="data:image/jpeg;base64," alt="Atardeceres contigo" style="object-position:38% 40%"></div>
<p class="cap">Atardeceres contigo</p></div></section>

  <section class="slide"><div class="in">
    <h2 class="script">Unos mensajitos para ti</h2>
    <p class="lead">Toca los corazones para descubrir lo que te quiero decir</p>
    <div class="hearts">
      <button class="h" data-i="0" aria-label="Mensaje 1">♥</button>
      <button class="h" data-i="1" aria-label="Mensaje 2">♥</button>
      <button class="h" data-i="2" aria-label="Mensaje 3">♥</button>
      <button class="h" data-i="3" aria-label="Mensaje 4">♥</button>
    </div>
    <p id="msg" aria-live="polite"></p>
  </div></section>

  <section class="slide"><div class="in">
    <h2 class="script">Una carta para ti</h2>
    <p class="lead" id="letterLead">Hay cosas que quiero decirte y que a veces no me salen como me gustaría.</p>
    <button class="envelope" id="env" aria-label="Abrir la carta">
      <div class="env-back"></div>
      <div class="flap"><svg viewBox="0 0 100 58" preserveAspectRatio="none"><path d="M0 0H100L50 58Z" fill="#f4a9bc" stroke="#e58aa4" stroke-width=".6"/></svg></div>
      <div class="seal">♥</div>
    </button>
    <div class="tap" id="tap">toca el sobre para abrirlo</div>
    <div class="sheet" id="sheet">Este es el regalo que menos te podrías esperar jaajajaj, bueno esto lo hago porque si, ya que como tu dices no tiene que ser una fecha para regalarte algo

Bueno esta carta es un poco mas corta que las otras que te he hecho, pero es para agradecerte de nuevo todo lo que haces por mi, lo que te esfuerzas tanto contigo misma como conmigo, gracias por quererme y por hacerme feliz

Espero que te guste este regalo, es un poco mas original

<span class="sign">Te quiero.</span></div>
  </div></section>

  <section class="slide final"><div class="in">
    <h2 class="script">Te quiero</h2>
    <p class="lead">Gracias por quererme y por hacerme feliz</p>
    <button class="big" id="big" aria-label="Lanzar corazones">♥</button>
    <p class="tap">toca el corazón</p>
    <p class="count" id="count"></p>
  </div></section>
</div>

<div id="nav">
  <div id="dots"></div>
  <button class="arrow" id="next" aria-label="Siguiente">→</button>
</div>

<script>
/* Si quieres el contador de días juntos, pon aquí vuestra fecha, por ejemplo '2024-05-18'. Déjalo vacío para ocultarlo. */
const START_DATE='';
const reasons=["Gracias por quererme ❤️","Te quiero 🫶","Gracias por estar siempre ahí ✨","¡Eres la mejor! 💗"];
const $=s=>document.querySelector(s);
const deck=$('#deck'), slides=[...deck.children];

/* Contraseña */
function unlock(){
  if($('#pass').value.trim()==='Naranja'){
    $('#lock').classList.add('gone');
    deck.classList.add('show'); $('#nav').classList.add('show');
    deck.scrollLeft=0; update();
  }else{
    $('#err').textContent='Contraseña incorrecta, inténtalo de nuevo';
    $('#pass').value='';
    const c=$('.card');c.classList.remove('shake');void c.offsetWidth;c.classList.add('shake');
  }
}
$('#enter').addEventListener('click',unlock);
$('#pass').addEventListener('keydown',e=>{if(e.key==='Enter')unlock()});

/* Navegación */
const dots=$('#dots');
slides.forEach(()=>dots.appendChild(document.createElement('i')));
let cur=0;
function update(){
  cur=Math.round(deck.scrollLeft/deck.clientWidth);
  [...dots.children].forEach((d,i)=>d.classList.toggle('on',i===cur));
  $('#next').disabled=cur>=slides.length-1;
}
deck.addEventListener('scroll',()=>requestAnimationFrame(update),{passive:true});
function go(i){deck.scrollTo({left:i*deck.clientWidth,behavior:'smooth'})}
$('#next').addEventListener('click',()=>go(Math.min(cur+1,slides.length-1)));
document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight')go(Math.min(cur+1,slides.length-1));
  if(e.key==='ArrowLeft')go(Math.max(cur-1,0));
});

/* Corazones al tocar */
function burst(x,y,n=1){
  for(let k=0;k<n;k++){
    const f=document.createElement('span');f.className='fly';f.textContent=['♥','♡','❤'][Math.random()*3|0];
    f.style.left=(x-10+(Math.random()*40-20))+'px';f.style.top=(y-10)+'px';
    f.style.setProperty('--dx',(Math.random()*120-60)+'px');f.style.setProperty('--rot',(Math.random()*60-30)+'deg');
    f.style.fontSize=(16+Math.random()*20)+'px';
    document.body.appendChild(f);setTimeout(()=>f.remove(),1500);
  }
}
document.addEventListener('pointerdown',e=>{if(!e.target.closest('input,#lock'))burst(e.clientX,e.clientY,1)});

/* Mensajes */
document.querySelectorAll('.h').forEach(b=>b.addEventListener('click',()=>{
  b.classList.add('on');
  const m=$('#msg');m.textContent=reasons[b.dataset.i];
  m.classList.remove('pop');void m.offsetWidth;m.classList.add('pop');
}));

/* Carta */
$('#env').addEventListener('click',()=>{
  const env=$('#env');env.classList.add('open');$('#tap').style.display='none';
  setTimeout(()=>{env.classList.add('gone');$('#letterLead').style.display='none';$('#sheet').classList.add('show')},800);
});

/* Final */
$('#big').addEventListener('click',e=>{
  const r=e.currentTarget.getBoundingClientRect();
  burst(r.left+r.width/2,r.top+r.height/2,18);
});
if(START_DATE){
  const d=Math.floor((Date.now()-new Date(START_DATE))/864e5);
  if(d>0)$('#count').textContent='Llevamos '+d+' días juntos';
}

/* Pétalos */
(function(){
  const c=$('#petals'),x=c.getContext('2d');let w,h,P=[];
  const cols=['#f4b6c6','#eb8fa9','#f9d0da','#e2708f'];
  function mk(top){return{x:Math.random()*w,y:top?-20:Math.random()*h,s:7+Math.random()*9,r:Math.random()*6,vr:(Math.random()-.5)*.03,
    vy:.5+Math.random()*.9,ph:Math.random()*6,c:cols[Math.random()*cols.length|0]}}
  function size(){const d=devicePixelRatio||1;w=innerWidth;h=innerHeight;c.width=w*d;c.height=h*d;x.setTransform(d,0,0,d,0,0);
    P=Array.from({length:Math.round(Math.min(34,w/12))},()=>mk(false))}
  function draw(){
    x.clearRect(0,0,w,h);
    for(const p of P){
      p.y+=p.vy;p.ph+=.015;p.x+=Math.sin(p.ph)*.7;p.r+=p.vr;
      if(p.y>h+20){Object.assign(p,mk(true))}
      x.save();x.translate(p.x,p.y);x.rotate(p.r);x.globalAlpha=.75;x.fillStyle=p.c;
      x.beginPath();x.ellipse(0,0,p.s,p.s*.55,0,0,7);x.fill();x.restore();
    }
    if(!matchMedia('(prefers-reduced-motion:reduce)').matches)requestAnimationFrame(draw);
  }
  addEventListener('resize',size);size();draw();
})();
</script>
</body>
</html>
